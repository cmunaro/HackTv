-	lzop = 'bin\\win32\\lzop.exe' if os.name == 'nt' else 'bin/linux-x86/lzop'
-	os.system(lzop + ' -o {} -d {}'.format(dest, src))
+	subprocess.run([_lzop_binary(), '-o', dest, '-d', src], check=True)
+
 
