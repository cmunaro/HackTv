+def _lzop_binary():
+	"""Return a native lzop executable on Windows, Linux, or macOS."""
+	if os.name == 'nt':
+		return os.path.join('bin', 'win32', 'lzop.exe')
+
+	# Prefer a system/Homebrew binary. The repository's bundled binary, when
+	# present, is Linux x86 and cannot execute on Apple Silicon macOS.
+	system_lzop = shutil.which('lzop')
+	if system_lzop:
+		return system_lzop
+
+	bundled_lzop = os.path.join('bin', 'linux-x86', 'lzop')
+	if os.path.isfile(bundled_lzop):
+		return bundled_lzop
+
+	raise RuntimeError('lzop was not found; install it with: brew install lzop')
+
+
